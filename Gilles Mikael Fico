<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Mikael, porteur de projets culturels et urbains à Cotonou, Bénin. Découvrez Made For Bounce.">
  <meta name="theme-color" content="#101714">
  <meta property="og:title" content="Mikael05 — Culture, ville et projets">
  <meta property="og:description" content="Des idées locales, une ambition ouverte. Découvrez le parcours de Mikael et le projet Made For Bounce.">
  <title>Mikael05 — Projets culturels & urbains</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      color-scheme: dark;
      --background: #101714;
      --surface: #17211d;
      --surface-light: #202c26;
      --text: #f5f4ed;
      --muted: #bec8c1;
      --accent: #c8eb70;
      --line: rgba(245, 244, 237, 0.13);
      --page-width: 1160px;
      --radius: 18px;
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 96px;
    }

    body {
      margin: 0;
      background:
        radial-gradient(ellipse at 85% 4%, rgba(200, 235, 112, 0.09), transparent 32rem),
        var(--background);
      color: var(--text);
      font: 400 16px/1.7 "DM Sans", system-ui, sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    a {
      color: inherit;
    }

    a:focus-visible,
    button:focus-visible,
    input:focus-visible,
    textarea:focus-visible {
      outline: 3px solid var(--accent);
      outline-offset: 4px;
    }

    .skip-link {
      position: absolute;
      top: 12px;
      left: 12px;
      z-index: 20;
      padding: 10px 14px;
      transform: translateY(-160%);
      border-radius: 6px;
      background: var(--accent);
      color: #142018;
    }

    .skip-link:focus {
      transform: translateY(0);
    }

    .container {
      width: min(var(--page-width), calc(100% - 48px));
      margin-inline: auto;
    }

    .site-header {
      position: sticky;
      top: 0;
      z-index: 10;
      border-bottom: 1px solid var(--line);
      background: rgba(16, 23, 20, 0.9);
      backdrop-filter: blur(14px);
    }

    .nav {
      min-height: 78px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }

    .brand {
      font: 800 1.05rem/1 "Manrope", sans-serif;
      letter-spacing: -0.06em;
      text-decoration: none;
    }

    .brand span {
      color: var(--accent);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: clamp(18px, 3vw, 36px);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .nav-links a {
      color: var(--muted);
      font-size: 0.9rem;
      text-decoration: none;
      transition: color 160ms ease;
    }

    .nav-links a:hover {
      color: var(--text);
    }

    .nav-contact {
      padding: 10px 16px;
      border: 1px solid var(--line);
      border-radius: 999px;
      color: var(--text) !important;
    }

    .hero {
      position: relative;
      isolation: isolate;
      min-height: 650px;
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(250px, 0.75fr);
      align-items: center;
      gap: 56px;
      padding-block: 92px;
    }

    .hero::before {
      position: absolute;
      z-index: -1;
      inset: 0 calc((1160px - 100vw) / 2);
      background:
        linear-gradient(90deg, rgba(16, 23, 20, 0.94), rgba(16, 23, 20, 0.76) 58%, rgba(16, 23, 20, 0.65)),
        linear-gradient(0deg, var(--background), transparent 45%),
        url("https://images.unsplash.com/photo-1519608487953-e999c86e7455?auto=format&fit=crop&w=2000&q=85") center 48% / cover no-repeat;
      content: "";
    }

    .eyebrow,
    .section-kicker {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 0 0 22px;
      color: var(--accent);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
    }

    .eyebrow::before {
      width: 26px;
      height: 1px;
      background: currentColor;
      content: "";
    }

    h1,
    h2,
    h3 {
      font-family: "Manrope", sans-serif;
    }

    h1 {
      max-width: 780px;
      margin: 0;
      font-size: clamp(3.2rem, 8vw, 6.8rem);
      font-weight: 700;
      letter-spacing: -0.085em;
      line-height: 0.98;
    }

    h1 span {
      color: var(--accent);
    }

    .hero-copy {
      max-width: 580px;
      margin: 26px 0 0;
      color: var(--muted);
      font-size: clamp(1.05rem, 2vw, 1.2rem);
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 14px;
      margin-top: 32px;
    }

    .button {
      display: inline-flex;
      min-height: 50px;
      align-items: center;
      justify-content: center;
      padding: 0 21px;
      border: 1px solid var(--accent);
      border-radius: 999px;
      background: var(--accent);
      color: #152019;
      font-weight: 700;
      text-decoration: none;
      transition: transform 160ms ease, background 160ms ease;
    }

    .button:hover {
      transform: translateY(-2px);
      background: #d7f58a;
    }

    .button-secondary {
      border-color: var(--line);
      background: rgba(16, 23, 20, 0.35);
      color: var(--text);
    }

    .button-secondary:hover {
      background: rgba(255, 255, 255, 0.08);
    }

    .location-card {
      min-height: 330px;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 28px;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background:
        radial-gradient(circle at 100% 0%, rgba(200, 235, 112, 0.18), transparent 55%),
        rgba(23, 33, 29, 0.84);
      box-shadow: 0 24px 70px rgba(0, 0, 0, 0.2);
    }

    .location-card p {
      margin: 0;
    }

    .location-label {
      margin-bottom: 10px !important;
      color: var(--muted);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .location {
      font: 700 clamp(2.4rem, 4vw, 3.6rem)/1.05 "Manrope", sans-serif;
      letter-spacing: -0.07em;
    }

    .location span {
      display: block;
      margin-top: 12px;
      color: var(--accent);
      font: 500 0.98rem/1.5 "DM Sans", sans-serif;
      letter-spacing: 0;
    }

    .section {
      padding-block: 88px;
      border-top: 1px solid var(--line);
    }

    .section-heading {
      display: grid;
      grid-template-columns: minmax(180px, 0.7fr) minmax(0, 1.3fr);
      gap: 40px;
      margin-bottom: 38px;
    }

    .section-kicker {
      margin-top: 8px;
    }

    h2 {
      max-width: 740px;
      margin: 0;
      font-size: clamp(2.1rem, 5vw, 3.8rem);
      font-weight: 600;
      letter-spacing: -0.075em;
      line-height: 1.07;
    }

    .about-copy {
      max-width: 720px;
      margin-left: auto;
      color: var(--muted);
      font-size: 1.08rem;
    }

    .about-copy p {
      margin: 0 0 18px;
    }

    .project-card {
      display: grid;
      grid-template-columns: 1fr 0.85fr;
      align-items: center;
      gap: 40px;
      padding: clamp(26px, 5vw, 58px);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background:
        radial-gradient(ellipse at 100% 0%, rgba(200, 235, 112, 0.12), transparent 50%),
        var(--surface);
    }

    .project-label {
      margin: 0 0 18px;
      color: var(--accent);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .project-card h3 {
      margin: 0;
      font-size: clamp(2.5rem, 5vw, 4.5rem);
      font-weight: 700;
      letter-spacing: -0.08em;
      line-height: 1;
    }

    .project-description {
      max-width: 540px;
      margin: 20px 0 0;
      color: var(--muted);
    }

    .project-note {
      padding: 24px;
      border-left: 2px solid var(--accent);
      border-radius: 0 12px 12px 0;
      background: rgba(255, 255, 255, 0.035);
      color: var(--muted);
    }

    .project-note strong {
      display: block;
      margin-bottom: 8px;
      color: var(--text);
      font-family: "Manrope", sans-serif;
    }

    .contact-section {
      padding-bottom: 100px;
    }

    .contact-box {
      display: grid;
      grid-template-columns: 1fr 0.8fr;
      gap: 40px;
      padding: clamp(26px, 5vw, 56px);
      border-radius: var(--radius);
      background: var(--accent);
      color: #152019;
    }

    .contact-box .section-kicker {
      color: #39472b;
    }

    .contact-box h2 {
      max-width: 620px;
    }

    .contact-intro {
      max-width: 500px;
      margin: 18px 0 0;
      color: #39472b;
    }

    .contact-details {
      display: grid;
      gap: 12px;
      align-content: center;
    }

    .contact-details a {
      display: flex;
      min-height: 50px;
      align-items: center;
      justify-content: center;
      padding: 10px 16px;
      border: 1px solid rgba(21, 32, 25, 0.3);
      border-radius: 8px;
      color: #152019;
      font-weight: 700;
      text-align: center;
      text-decoration: none;
      transition: background 160ms ease;
    }

    .contact-details a:hover {
      background: rgba(21, 32, 25, 0.08);
    }

    .contact-form {
      display: grid;
      gap: 14px;
      margin-top: 24px;
    }

    .field {
      display: grid;
      gap: 6px;
    }

    .field label {
      font-size: 0.9rem;
      font-weight: 700;
    }

    .field input,
    .field textarea {
      width: 100%;
      padding: 13px 14px;
      border: 1px solid rgba(21, 32, 25, 0.24);
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.55);
      color: #152019;
      font: inherit;
    }

    .field input::placeholder,
    .field textarea::placeholder {
      color: #59645a;
    }

    .field textarea {
      min-height: 110px;
      resize: vertical;
    }

    .submit-button {
      min-height: 50px;
      padding: 10px 18px;
      border: 0;
      border-radius: 8px;
      background: #152019;
      color: var(--text);
      font: inherit;
      font-weight: 700;
      cursor: pointer;
      transition: background 160ms ease;
    }

    .submit-button:hover {
      background: #26372c;
    }

    .form-note {
      margin: 0;
      color: #39472b;
      font-size: 0.82rem;
    }

    .site-footer {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      padding-block: 24px;
      border-top: 1px solid var(--line);
      color: var(--muted);
      font-size: 0.88rem;
    }

    .site-footer p {
      margin: 0;
    }

    @media (max-width: 760px) {
      .nav {
        min-height: 70px;
      }

      .nav-links {
        gap: 14px;
      }

      .nav-links a {
        font-size: 0.82rem;
      }

      .nav-contact {
        display: none;
      }

      .hero {
        min-height: auto;
        grid-template-columns: 1fr;
        gap: 36px;
        padding-block: 76px 64px;
      }

      .hero::before {
        inset: 0 -24px;
        background-position: center;
      }

      .location-card {
        min-height: 240px;
      }

      .section {
        padding-block: 68px;
      }

      .section-heading,
      .project-card,
      .contact-box {
        grid-template-columns: 1fr;
        gap: 24px;
      }

      .about-copy {
        margin-left: 0;
      }

      .contact-details {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media (max-width: 480px) {
      .container {
        width: min(var(--page-width), calc(100% - 36px));
      }

      .nav {
        gap: 12px;
      }

      .nav-links {
        gap: 10px;
      }

      .nav-links a {
        font-size: 0.74rem;
      }

      .hero-actions {
        align-items: stretch;
        flex-direction: column;
      }

      .button {
        width: 100%;
      }

      .contact-details {
        grid-template-columns: 1fr;
      }

      .site-footer {
        flex-direction: column;
        gap: 5px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }

      *,
      *::before,
      *::after {
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>

<body>
  <a class="skip-link" href="#contenu">Aller au contenu</a>

  <header class="site-header">
    <nav class="nav container" aria-label="Navigation principale">
      <a class="brand" href="#accueil" aria-label="Mikael05, accueil">MIKAEL<span>05</span></a>
      <ul class="nav-links">
        <li><a href="#apropos">À propos</a></li>
        <li><a href="#projet">Projet</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
      <a class="nav-links nav-contact" href="#contact">Me contacter</a>
    </nav>
  </header>

  <main id="contenu">
    <div class="container">
      <section class="hero" id="accueil" aria-labelledby="titre-principal">
        <div>
          <p class="eyebrow">Culture · Ville · Entreprendre</p>
          <h1 id="titre-principal">Faire grandir les idées <span>qui rassemblent.</span></h1>
          <p class="hero-copy">
            Je suis Mikael, étudiant et porteur de projets culturels et urbains à Cotonou.
            J’aime transformer une idée ambitieuse en initiative concrète.
          </p>
          <div class="hero-actions">
            <a class="button" href="#contact">Parlons de votre projet</a>
            <a class="button button-secondary" href="#projet">Découvrir Made For Bounce</a>
          </div>
        </div>

        <aside class="location-card" aria-label="Localisation : Cotonou, Bénin">
          <p class="location-label">Ancré au Bénin</p>
          <p class="location">Cotonou<span>Des idées locales, une ambition ouverte.</span></p>
        </aside>
      </section>

      <section class="section" id="apropos" aria-labelledby="titre-apropos">
        <div class="section-heading">
          <p class="section-kicker">01 / À propos</p>
          <h2 id="titre-apropos">Créer du lien. Construire du concret.</h2>
        </div>
        <div class="about-copy">
          <p>
            Je m’appelle Mikael. Basé à Cotonou, au Bénin, j’étudie la géographie et
            l’aménagement du territoire, tout en m’investissant dans des projets culturels
            et urbains.
          </p>
          <p>
            Ce qui m’anime : réunir une équipe, mobiliser des partenaires et donner vie
            à des expériences qui rassemblent un public.
          </p>
        </div>
      </section>

      <section class="section" id="projet" aria-labelledby="titre-projet">
        <div class="section-heading">
          <p class="section-kicker">02 / Projet à l’honneur</p>
          <h2 id="titre-projet">Une ambition qui prend forme.</h2>
        </div>

        <article class="project-card">
          <div>
            <p class="project-label">Projet culturel · Cotonou</p>
            <h3>Made For Bounce</h3>
            <p class="project-description">
              Un projet de festival urbain annuel pensé pour faire vibrer Cotonou
              et mettre en lumière sa créativité.
            </p>
          </div>
          <div class="project-note">
            <strong>Partenaires & sponsors</strong>
            Le projet vous intéresse ? Je suis ouvert aux échanges avec les marques,
            partenaires et personnes qui souhaitent contribuer à son développement.
          </div>
        </article>
      </section>

      <section class="section contact-section" id="contact" aria-labelledby="titre-contact">
        <div class="contact-box">
          <div>
            <p class="section-kicker">03 / Contact</p>
            <h2 id="titre-contact">Et si on construisait quelque chose ensemble ?</h2>
            <p class="contact-intro">
              Pour parler de Made For Bounce, d’un partenariat ou d’une nouvelle idée,
              contactez-moi directement.
            </p>

            <form class="contact-form" id="contact-form">
              <div class="field">
                <label for="nom">Votre nom</label>
                <input id="nom" name="nom" type="text" autocomplete="name" placeholder="Ex. Marie" required>
              </div>

              <div class="field">
                <label for="email">Votre adresse email</label>
                <input id="email" name="email" type="email" autocomplete="email" placeholder="vous@exemple.com" required>
              </div>

              <div class="field">
                <label for="message">Votre message</label>
                <textarea id="message" name="message" placeholder="Parlez-moi de votre projet..." required></textarea>
              </div>

              <button class="submit-button" type="submit">Préparer mon email</button>
              <p class="form-note">Votre application de messagerie s’ouvrira pour envoyer le message.</p>
            </form>
          </div>

          <div class="contact-details" aria-label="Autres moyens de contact">
            <a href="https://wa.me/2290148057370" target="_blank" rel="noopener noreferrer">Me contacter sur WhatsApp</a>
            <a href="mailto:Mikaelfico85@gmail.com">M’écrire directement par email</a>
          </div>
        </div>
      </section>
    </div>
  </main>

  <footer class="site-footer container">
    <p>© <span id="year"></span> Mikael05</p>
    <p>Cotonou, Bénin</p>
  </footer>

  <script>
    document.getElementById("year").textContent = new Date().getFullYear();

    document.getElementById("contact-form").addEventListener("submit", function (event) {
      event.preventDefault();

      const name = document.getElementById("nom").value.trim();
      const email = document.getElementById("email").value.trim();
      const message = document.getElementById("message").value.trim();

      const subject = encodeURIComponent("Message depuis le site Mikael05");
      const body = encodeURIComponent(
        `Nom : ${name}\nEmail : ${email}\n\nMessage :\n${message}`
      );

      window.location.href =
        `mailto:Mikaelfico85@gmail.com?subject=${subject}&body=${body}`;
    });
  </script>
</body>
</html>
